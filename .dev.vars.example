# Example environment variables for local development
# Remove INTERNAL_SERVICE_KEY as it's no longer used for worker-to-worker auth
# INTERNAL_SERVICE_KEY=your_internal_service_key_here

# D1_WORKER_URL is also likely no longer needed if calls only come via bindings
# D1_WORKER_URL=http://127.0.0.1:8787

# Add other necessary dev variables here

# Note: This file provides example values for local development.
# Copy this file to .dev.vars and replace with your actual values.
# .dev.vars is ignored by git to prevent committing sensitive information. 